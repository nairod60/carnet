<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Carnet" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/green</item>
        <item name="colorAccent">@color/green</item>
    </style>

    <style name="Theme.Carnet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Carnet</item>
    </style>
</resources>
